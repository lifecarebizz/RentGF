# Database
DATABASE_URL="postgresql://user:password@host:5432/rentgf"

# Auth
NEXTAUTH_SECRET="your-secret-min-32-chars-change-in-production"
NEXTAUTH_URL="https://your-domain.com"

# Razorpay Payments
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@rentgf.com"

# File Upload (Cloudflare R2 / S3)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="rentgf-uploads"
R2_PUBLIC_URL="https://your-r2-bucket.r2.dev"

# App
NEXT_PUBLIC_APP_URL="https://your-domain.com"
