generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  displayName      String
  fullName         String
  phone            String?
  dateOfBirth      DateTime?
  country          String?
  city             String?
  role             String    @default("CUSTOMER")
  status           String    @default("ACTIVE")
  avatarUrl        String?
  emailVerified    Boolean   @default(false)
  accessGranted    Boolean   @default(false)
  isOnline         Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customerProfile CustomerProfile?
  companionProfile CompanionProfile?
  favorites       Favorite[]
  bookings        Booking[]
  reviewsGiven    Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewee")
  notifications   Notification[]
  conversationParticipants ConversationParticipant[]
  messagesSent    Message[]
  reportsSent     Report[]
  blocksSent      Block[]
  auditLogs       AuditLog[]
  tempTokens      TempToken[]
  earnings        Earnings[]
  payouts         Payout[]
  payments        Payment[]

  @@map("users")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languages String[] @default([])
  interests String[] @default([])
  bio       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

model CompanionProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city             String?
  languages        String[]        @default([])
  interests        String[]        @default([])
  categories       String[]        @default([])
  bio              String?         @db.Text
  startingPrice    Float?
  availabilityDays String[]        @default([])
  availabilityTimes String[]        @default([])
  onboardingStep   Int             @default(0)
  onboardingComplete Boolean       @default(false)
  isDiscoverable   Boolean         @default(false)
  isPublic         Boolean         @default(false)
  verificationStatus String        @default("NOT_SUBMITTED")
  totalEarnings    Float           @default(0)
  completedBookings Int            @default(0)
  averageRating    Float?
  reviewCount      Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  bookings        Booking[]
  reviewsReceived Review[]
  earnings        Earnings[]
  payouts         Payout[]
  favorites       Favorite[]
  notifications   Notification[]
  documents       VerificationDocument[]

  @@map("companion_profiles")
}

model VerificationDocument {
  id           String            @id @default(cuid())
  companionId  String
  companion    CompanionProfile  @relation(fields: [companionId], references: [id], onDelete: Cascade)
  documentType String
  documentUrl  String
  isVerified   Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@map("verification_documents")
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("cities")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("categories")
}

model Interest {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("interests")
}

model Favorite {
  id          String   @id @default(cuid())
  customerId  String
  companionId String
  createdAt   DateTime @default(now())

  customer   User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  companion  CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([customerId, companionId])
  @@map("favorites")
}

model Booking {
  id               String          @id @default(cuid())
  customerId       String
  companionId      String
  status           String          @default("PENDING")
  bookingDate      DateTime
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int
  activityType     String?
  message          String?         @db.Text
  price            Float
  discountAmount   Float           @default(0)
  finalPrice       Float
  currency         String          @default("INR")
  cancelledBy      String?
  cancellationReason String?       @db.Text
  cancelledAt      DateTime?
  completedAt      DateTime?
  paymentId        String?
  paymentStatus    String?         @default("PENDING")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customer   User             @relation("CustomerBooking", fields: [customerId], references: [id])
  companion  User             @relation("CompanionBooking", fields: [companionId], references: [id])
  reviews    Review[]
  notifications Notification[]

  @@unique([customerId, companionId, bookingDate, startTime])
  @@map("bookings")
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  paymentId      String?  @unique
  userId         String
  bookingId      String?
  amount         Float
  discountAmount Float    @default(0)
  finalAmount    Float
  currency       String   @default("INR")
  discountId     String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User   @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model AccessEntitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId String
  grantedAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@map("access_entitlements")
}

model Discount {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String
  value       Float
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  marketingLabel String?
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("discounts")
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("platform_settings")
}

model Earnings {
  id                 String             @id @default(cuid())
  companionId        String
  companion          CompanionProfile   @relation(fields: [companionId], references: [id], onDelete: Cascade)
  bookingId          String
  booking            Booking            @relation(fields: [bookingId], references: [id])
  bookingAmount      Float
  platformCommission Float
  companionEarnings  Float
  payoutStatus       String             @default("PENDING")
  createdAt          DateTime           @default(now())

  @@unique([bookingId])
  @@map("earnings")
}

model Payout {
  id              String            @id @default(cuid())
  companionId     String
  companion       CompanionProfile  @relation(fields: [companionId], references: [id], onDelete: Cascade)
  amount          Float
  payoutStatus    String            @default("PENDING")
  payoutReference String?
  requestedDate   DateTime
  processedDate   DateTime?
  adminNotes      String?           @db.Text
  createdAt       DateTime          @default(now())

  @@map("payouts")
}

model Conversation {
  id         String              @id @default(cuid())
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  participants ConversationParticipant[]
  messages   Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  isBlocked      Boolean      @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id            String      @id @default(cuid())
  conversationId String
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("messages")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?  @db.Text
  isVerified Boolean  @default(false)
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@map("reviews")
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User     @relation("ReportReported", fields: [reportedUserId], references: [id])
  category       String
  description    String?  @db.Text
  status         String   @default("OPEN")
  adminNotes     String?  @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@map("reports")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String   @db.Text
  isRead      Boolean  @default(false)
  relatedId   String?
  relatedType String?
  createdAt   DateTime @default(now())

  @@map("notifications")
}

model FAQ {
  id          String   @id @default(cuid())
  question    String   @db.Text
  answer      String   @db.Text
  category    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("faqs")
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("content_pages")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminAudit", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model TempToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("temp_tokens")
}
